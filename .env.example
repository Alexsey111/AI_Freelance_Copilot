# --- Application ---
APP_ENV=development
APP_NAME=AI Freelance Copilot
LOG_LEVEL=INFO

# --- Storage (MVP: SQLite через Repository Layer, меняется на PostgreSQL без правки бизнес-логики) ---
DATABASE_URL=sqlite:///./data/app.db
# DB_ECHO=true печатает SQL-запросы (отладка)
DB_ECHO=false

# --- LLM ---
# mock   --- детерминированный офлайн-провайдер (используется в тестах, не тратит деньги)
# openai --- любой OpenAI-совместимый endpoint (OpenAI, proxyapi.ru, DeepSeek, ollama /v1)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_S=60
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1500

# --- Бизнес-правила (ручная проверка) ---
DEFAULT_PROFILE_ID=1
MIN_DESCRIPTION_CHARS=40
MATCH_SCORE_REVIEW_THRESHOLD=0.35
LLM_SCORE_CROSSCHECK_DELTA=0.5
MIN_DRAFT_REPLY_CHARS=80

# --- Мини-экономика ---
# Ставка для оценки заказа в часах: DEFAULT_HOURLY_RATE_RUB задаётся в коде
# (app/domain/services/metrics_service.py) и здесь не переопределяется.

# --- Frontend ---
# 127.0.0.1, а не localhost: на Windows localhost идёт сначала в IPv6 (::1), а порт там
# может занимать ретранслятор Docker от чужого контейнера -> панель получает 404.
BACKEND_URL=http://127.0.0.1:8000
